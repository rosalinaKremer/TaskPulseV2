# Copy to .env for reference; Django reads real environment variables.
# Locally you only need DJANGO_DEBUG=True. Everything else has a dev default.

DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Comma separated. Render's own hostname is added automatically.
DJANGO_ALLOWED_HOSTS=
# Render Postgres "Internal Database URL". Leave unset to use SQLite locally.
DATABASE_URL=postgres://user:password@host:5432/taskpulse
# Your Vercel site, no trailing slash. Comma separated for several.
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# Optional: allow Vercel preview deployments.
CORS_ALLOWED_ORIGIN_REGEXES=
# Optional: extra origins allowed to POST forms (admin). Render's host is added automatically.
CSRF_TRUSTED_ORIGINS=
