# Django reads real environment variables; this file is a reference.
# Locally you only need DJANGO_DEBUG=True and a MongoDB on localhost:27017
# (or set MONGODB_URI to an Atlas cluster).

DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Comma separated. Render's own hostname is added automatically.
DJANGO_ALLOWED_HOSTS=
# MongoDB Atlas: Connect > Drivers > copy the string, fill in the password.
MONGODB_URI=mongodb+srv://taskpulse:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Database name inside the cluster (created automatically on first write).
MONGODB_NAME=taskpulse
# Your Vercel site, no trailing slash. Comma separated for several.
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# Optional: allow Vercel preview deployments.
CORS_ALLOWED_ORIGIN_REGEXES=
# Optional: extra origins allowed to POST forms (admin). Render's host is added automatically.
CSRF_TRUSTED_ORIGINS=
